{
  "name": "trends-dashboard",
  "version": "1.0.0",
  "description": "Dashboard of press coverage of celebrity outfits, one column per star.",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env scripts/dev.js",
    "fetch:once": "node --env-file-if-exists=.env scripts/fetch-once.js",
    "diagnose": "node --env-file-if-exists=.env scripts/diagnose-articles.js",
    "check-key": "node --env-file-if-exists=.env scripts/check-key.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  }
}
