# IA — optionnel, deux fournisseurs, une seule clé suffit.
# Sert à rédiger les brouillons et à identifier les pièces sur les photos.
# Si les deux sont renseignés, Gemini passe en premier et Groq prend le relais
# quand il échoue. Sans aucune clé, tout continue de fonctionner sans IA :
# la marque est alors lue dans la légende de la photo.

# Option A : Gemini — https://aistudio.google.com/apikey (sans carte bancaire).
# Le quota gratuit dépend du projet Cloud lié à la clé ; un 429 « quota »
# persistant signifie que ce projet n'a pas d'allocation gratuite.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Option B : Groq — https://console.groq.com/keys
# Aucun projet Cloud, aucune facturation à configurer. Le repli le plus sûr
# quand Gemini refuse le quota.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Modèle de vision, utilisé dès qu'une photo est envoyée : le modèle texte
# ci-dessus est aveugle, et identifier une tenue sans voir l'image ne marche pas.
# Laisse VIDE : le catalogue Groq est interrogé et un modèle multimodal est
# choisi automatiquement. Ces noms changent, et un nom périmé renvoie un 404.
# `npm run check-ai` affiche le catalogue et le modèle retenu.
GROQ_VISION_MODEL=

# Affiliation — optionnel, les deux plateformes sont interrogées et la
# première qui répond fournit le lien.

# ShopMy : clé depuis ton compte créateur
SHOPMY_API_KEY=

# impact.com : identifiants publisher + l'id du programme sur lequel tu es validé
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
IMPACT_PROGRAM_ID=

# Recherche Google — deux options déployables, une seule suffit.
# Si les deux sont renseignées, Serper passe en premier.

# ── Option A : Serper — la plus rapide à mettre en place ─────────────
# Renvoie les résultats Google en JSON contre une seule clé : pas de projet
# Cloud, pas d'API à activer, pas de restrictions de clé à régler.
# 2500 recherches offertes à l'inscription : https://serper.dev
SERPER_API_KEY=

# ── Option B : API officielle Google Custom Search ────────────────────
# JSON, sans navigateur, sans captcha, 100 requêtes/jour gratuites.
# Trois étapes, dans cet ordre :
#
#   1. GOOGLE_CSE_ID — crée un moteur sur
#      https://programmablesearchengine.google.com/controlpanel/create
#      puis, dans ses paramètres, active « Rechercher sur l'ensemble du Web ».
#      L'identifiant se trouve dans l'onglet « Vue d'ensemble ».
#
#   2. Active l'API — lien direct, un seul bouton « ACTIVER » :
#      https://console.cloud.google.com/apis/library/customsearch.googleapis.com
#
#   3. GOOGLE_API_KEY — https://console.cloud.google.com/apis/credentials
#      « + CRÉER DES IDENTIFIANTS » → « Clé API ».
#      L'ordre compte : une clé créée avant l'activation renvoie un 403.
#
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Navigateur — optionnel
# Sert uniquement à lire les pages des éditeurs qui refusent les requêtes
# ordinaires, et de repli pour la recherche si aucune clé n'est configurée.
# Les liens Google News redirigent en JavaScript : seul un vrai navigateur les
# suit. Playwright est installé en dépendance optionnelle ; il reste à
# télécharger Chromium une fois :
#     npx playwright install chromium
# Si tu as déjà Chrome ou Chromium, pointe-le ici pour éviter le
# téléchargement (~300 Mo). Sur macOS :
# CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROMIUM_PATH=
BROWSER_TIMEOUT_MS=25000

# La fenêtre reste masquée par défaut. Ne la montre (BROWSER_HEADLESS=false)
# que pour utiliser la recherche par navigateur sans clé API, afin de pouvoir
# résoudre une vérification Google à la main.
# BROWSER_HEADLESS=false
CAPTCHA_WAIT_MS=180000

# Serveur
PORT=3000
REFRESH_COOLDOWN_MS=30000
